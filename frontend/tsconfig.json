{
    "extends": "../tsconfig.json",
    "include": [
        "src",
        "vite.config.ts"
    ],
    "exclude": [
        "node_modules"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "typeRoots": [
            "../node_modules/@types"
        ],
        "types": [
            "node"
        ],
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@shared/*": [
                "../shared/*"
            ]
        },
        "noEmit": true
    }
}